{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build.cjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/variation-1-night-shift", "destination": "/", "permanent": true },
    { "source": "/variation-1-night-shift.html", "destination": "/", "permanent": true }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
    ] }
  ]
}
